# Copy to .env.local. Only NEXT_PUBLIC_* values reach the browser.
# Without the two Supabase values the Portal runs in demo mode (mock login and data).

# Supabase → Project Settings → API Keys (the publishable key, sb_publishable_…)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only, not used yet (docs/PORTAL_SPEC.md → Environment variables)
SUPABASE_SERVICE_ROLE_KEY=
ALLOWED_USER_ID=
GEMINI_API_KEY= 
# Tried in order; a model that times out or is overloaded falls through to the next
GEMINI_MODELS=gemini-3.6-flash,gemini-flash-latest,gemini-3.5-flash-lite
RESEND_API_KEY=
DIGEST_TO_EMAIL=
CRON_SECRET=
GITHUB_DISPATCH_TOKEN=
