# Copy to .env.local. Only NEXT_PUBLIC_* values reach the browser.
# Without the two Supabase values the Portal runs in demo mode (mock login and data).

# Supabase → Project Settings → API Keys (the publishable key, sb_publishable_…)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only (docs/PORTAL_SPEC.md → Environment variables)
# The secret key (sb_secret_…): the weekly-digest cron reads every module with it. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Your auth user id: the only user the API routes accept and the one the digest cron emails.
ALLOWED_USER_ID=
GEMINI_API_KEY= 
# Tried in order; a model that times out or is overloaded falls through to the next.
# Fastest reliable first: an overloaded first model costs up to 5s on quick add and 15s elsewhere.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash,gemini-flash-latest
RESEND_API_KEY=
# Where the digest goes (server only). Must be the Resend account's email until a domain is verified.
DIGEST_TO_EMAIL=
# Any long random string; Vercel sends it as "Authorization: Bearer …" to /api/cron/*.
CRON_SECRET=
GITHUB_DISPATCH_TOKEN=
